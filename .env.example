# =====================================================================
# HEARTGUARD AI — ENVIRONMENT VARIABLES
# =====================================================================

# ---------------------------------------------------------------------
# VERCEL (FRONTEND) CONFIGURATION
# ---------------------------------------------------------------------
# The public HTTPS URL of your Render backend API
# Local development: http://localhost:8000
# Production: https://<YOUR-RENDER-SERVICE>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------
# RENDER (BACKEND) CONFIGURATION
# ---------------------------------------------------------------------
# The public HTTPS URL of your Vercel frontend app (used for strict CORS)
# Local development: http://localhost:3000
# Production: https://<YOUR-VERCEL-APP>.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional comma-separated additional origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
